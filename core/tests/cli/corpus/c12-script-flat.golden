## do-not-edit

R> enable
R# conf t
R(config)# hostname Before
!intent rename Before
Before(config)# end
## script
Before> enable
Before# configure terminal
Before(config)# hostname Scripted
!intent rename Scripted
Scripted(config)# interface g0/0
Scripted(config-if)# ip address 10.7.0.1 255.255.255.0
Scripted(config-if)# bogus-command
Translating "bogus-command" ...domain server (255.255.255.255)
!err % Unknown command or computer name, or unable to find computer address
Scripted(config-if)# no shutdown
Scripted(config-if)# end
!error 5 % Unknown command or computer name, or unable to find computer address
## endscript
