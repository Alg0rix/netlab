+/*
+ * =========================================================================
+ * WASM bridge NIO (Emscripten builds only)
+ * =========================================================================
+ */
+#ifdef __EMSCRIPTEN__
+extern void *nl_nio_wasm_new(int link_id);
+extern ssize_t nl_nio_wasm_send(void *desc,void *pkt,size_t len);
+extern ssize_t nl_nio_wasm_recv(void *desc,void *pkt,size_t len);
+extern void nl_nio_wasm_free(void *desc);
+
+/* Create a new NetIO descriptor with WASM bridge method */
+netio_desc_t *netio_desc_create_wasm(char *nio_name,int link_id)
+{
+   netio_desc_t *nio;
+   void *d;
+
+   if (!(d = nl_nio_wasm_new(link_id)))
+      return NULL;
+
+   if (!(nio = netio_create(nio_name))) {
+      nl_nio_wasm_free(d);
+      return NULL;
+   }
+
+   nio->type = NETIO_TYPE_WASM;
+   nio->send = nl_nio_wasm_send;
+   nio->recv = nl_nio_wasm_recv;
+   nio->free = nl_nio_wasm_free;
+   nio->dptr = d;
+
+   if (netio_record(nio) == -1) {
+      netio_free(nio,NULL);
+      return NULL;
+   }
+
+   return nio;
+}
+#endif
